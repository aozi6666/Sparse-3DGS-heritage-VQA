# Example shell variables. serve.sh does not automatically read this file.
# Keep model disabled until GPU validation is scheduled.
DEMO_ENABLE_MODEL=0
DEMO_PORT=7860
# Model path is fixed to Project/models/mage-vl. Runtime enforces offline mode.
# Frames=16, max_pixels=150000, segment=8s are current baseline constants.
# Browser SpeechSynthesis handles TTS; no external API credentials required.
