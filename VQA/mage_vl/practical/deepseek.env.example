# 仅占位示例；不要把真实密钥提交到git或发给助手。推荐终端read -s后export。
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_OWN_KEY_LOCALLY
# 模型固定 deepseek-flash（官方图片输入），https://api.deepseek.com/chat/completions
# 是否允许付费调用由你在运行前设置：DEEPSEEK_API_CONFIRMED=1
# --max-calls 是本配置累计请求次数上限，含失败/结果不确定的请求。
# --max-total-tokens 为已有响应用量停止线，单次请求可能越线，不是金额硬上限。
